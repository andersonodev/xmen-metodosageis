# 🔧 CONFIGURAÇÕES PARA DESENVOLVIMENTO LOCAL
DEBUG=True
SECRET_KEY=django-insecure-xmen-agileteam-development-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (SQLite para desenvolvimento)
DATABASE_URL=sqlite:///db.sqlite3

# Redis (local)
REDIS_URL=redis://localhost:6379/0

# Email (desenvolvimento - exibe no console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@xmen-agileteam.com

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================================
# 🚀 CONFIGURAÇÕES PARA HEROKU (PRODUÇÃO)
# ========================================
# As seguintes variáveis são configuradas automaticamente no Heroku:
#
# SECRET_KEY=chave-super-secreta-gerada-pelo-heroku
# DEBUG=False
# DATABASE_URL=postgres://user:pass@host:port/dbname  (Heroku Postgres)
# REDIS_URL=redis://h:pass@host:port (Heroku Redis)
# HEROKU_APP_NAME=nome-do-seu-app
#
# Para configurar no Heroku, use:
# heroku config:set SECRET_KEY="sua-chave-super-secreta"
# heroku config:set DEBUG=False